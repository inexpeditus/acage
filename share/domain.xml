<!--
  libvirt domain template for agentcage VMs (Linux, libvirt backend).

  agentcage fills in the name, memory, vCPU count and disk path. With a shared
  folder it fills in the folder and keeps the virtiofs filesystem device and
  the shared memory backing it needs; without one it removes both.

  Hardened: no clipboard or guest-agent channel, no audio, no USB controller,
  no tablet, no VMware backdoor port, and the SPICE display doesn't listen on
  the network. No UUIDs, MACs, PCI addresses or firmware paths: libvirt fills
  those in for the host it runs on.
  Note: XML comments must not contain two hyphens in a row.
-->
<domain type="kvm">
  <name>agentcage</name>
  <description>Created by agentcage</description>
  <memory unit="KiB">2097152</memory>
  <currentMemory unit="KiB">2097152</currentMemory>
  <memoryBacking>
    <source type="memfd"/>
    <access mode="shared"/>
  </memoryBacking>
  <vcpu placement="static">2</vcpu>
  <os firmware="efi">
    <type arch="x86_64" machine="q35">hvm</type>
    <firmware>
      <feature enabled="no" name="enrolled-keys"/>
      <feature enabled="no" name="secure-boot"/>
    </firmware>
    <bootmenu enable="no"/>
    <smbios mode="sysinfo"/>
  </os>
  <!--
    Tells cloud-init to use the NoCloud seed ISO straight away, instead of
    spending minutes retrying EC2/OpenStack style metadata URLs that do not
    exist on a local libvirt network.
  -->
  <sysinfo type="smbios">
    <system>
      <entry name="serial">ds=nocloud</entry>
    </system>
  </sysinfo>
  <features>
    <acpi/>
    <apic/>
    <vmport state="off"/>
  </features>
  <cpu mode="host-passthrough" check="none" migratable="on"/>
  <clock offset="utc">
    <timer name="rtc" tickpolicy="catchup"/>
    <timer name="pit" tickpolicy="delay"/>
    <timer name="hpet" present="no"/>
  </clock>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <pm>
    <suspend-to-mem enabled="no"/>
    <suspend-to-disk enabled="no"/>
  </pm>
  <devices>
    <disk type="file" device="disk">
      <driver name="qemu" type="qcow2" discard="unmap"/>
      <source file="@DISK_PATH@"/>
      <target dev="vda" bus="virtio"/>
      <boot order="1"/>
    </disk>
    <disk type="file" device="cdrom">
      <driver name="qemu" type="raw"/>
      <target dev="sda" bus="sata"/>
      <readonly/>
    </disk>
    <filesystem type="mount" accessmode="passthrough">
      <driver type="virtiofs"/>
      <source dir="@SHARED_DIR@"/>
      <target dir="agentcage"/>
    </filesystem>
    <interface type="network">
      <source network="default"/>
      <model type="virtio"/>
    </interface>
    <serial type="pty">
      <target type="isa-serial" port="0"/>
    </serial>
    <console type="pty">
      <target type="serial" port="0"/>
    </console>
    <controller type="usb" model="none"/>
    <graphics type="spice">
      <listen type="none"/>
      <image compression="off"/>
    </graphics>
    <audio id="1" type="none"/>
    <video>
      <model type="virtio" heads="1" primary="yes"/>
    </video>
    <watchdog model="itco" action="reset"/>
    <memballoon model="virtio"/>
    <rng model="virtio">
      <backend model="random">/dev/urandom</backend>
    </rng>
  </devices>
</domain>
