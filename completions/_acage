#compdef acage
# zsh completion for acage.  Installed as
#   $PREFIX/share/zsh/site-functions/_acage
# Dynamic VM-name completion comes from `acage _complete`.

local curcontext="$curcontext" state line
typeset -A opt_args

local -a commands
commands=(
  'install:Download and verify the image, then create and boot a VM'
  'image:Download and verify the latest Alpine cloud image only'
  'create:Create and boot a VM from the downloaded image'
  'attach:Log in to a VM (starting it first if stopped)'
  'push:Copy files or folders into the agent home'
  'ssh:Run a command in a VM'
  'start:Start a stopped VM'
  'stop:Shut a VM down'
  'console:Show the serial console / boot output'
  'list:List VMs'
  'delete:Delete a VM and its disk'
  'uninstall:Remove every VM and all acage data'
  'help:Show help'
)

_acage_vms() {
  local -a vms
  vms=(${(f)"$(acage _complete 2>/dev/null)"})
  _describe -t vms 'VM' vms
}

_arguments -C \
  '(-h --help)'{-h,--help}'[Show help]' \
  '--version[Show the version]' \
  '--backend[Backend to use]:backend:(libvirt qemu)' \
  '--pool-dir[Where images and disks are kept]:dir:_files -/' \
  '(-y --yes)'{-y,--yes}'[Do not ask for confirmations]' \
  '(-n --dry-run)'{-n,--dry-run}'[Print what would change]' \
  '(-v --verbose)'{-v,--verbose}'[Print each command as it runs]' \
  '1: :->cmd' \
  '*:: :->args'

case $state in
  cmd)
    _describe -t commands 'acage command' commands ;;
  args)
    case $line[1] in
      attach|ssh|start|stop|console|delete)
        _acage_vms ;;
      push)
        _arguments \
          '--agent[As the agent account]' \
          '--user[As your account]' \
          '--to[Copy into DIR inside the home]:dir:' \
          '1:vm:_acage_vms' \
          '*:file:_files' ;;
      install|create)
        _arguments \
          '--name[VM name]:name:' \
          '--user[Your account in the VM]:user:' \
          '--harness[Agent harness(es)]:harness:(claude-code pi codex none)' \
          '--share[Share a host folder]:dir:_files -/' \
          '--password[Set a password for your account]' \
          '--no-doas[Do not give your account root either]' \
          '--allow-lan[Let the VM reach your LAN and host]' \
          '--ram[RAM in MB]:mb:' \
          '--vcpus[vCPUs]:n:' \
          '--disk[Disk size in GB]:gb:' \
          '--ssh-pubkey[Public key to authorize]:file:_files' \
          '--no-wait[Return without waiting for first boot]' ;;
    esac ;;
esac
