#!/usr/bin/env bash
# agentcage: run a coding agent in a disposable, locked-down Alpine Linux VM.
#
# Downloads and verifies Alpine's official cloud image, builds a first-boot
# (cloud-init) config with your SSH key and the agent harness(es) you pick,
# and boots a hardened VM with libvirt (or QEMU directly).
# See README.md.
set -euo pipefail

VERSION=0.2.0

# Find lib/ and share/: next to this script in a checkout, or under
# PREFIX/lib/agentcage and PREFIX/share/agentcage when installed.
self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case "$target" in /*) self=$target ;; *) self=$(dirname "$self")/$target ;; esac
done
DIR=$(cd "$(dirname "$self")" && pwd)
if [ -d "$DIR/lib" ]; then
  LIB_DIR=$DIR/lib; DATA_DIR=$DIR/share
else
  LIB_DIR=$DIR/../lib/agentcage; DATA_DIR=$DIR/../share/agentcage
fi

for f in common pool alpine harness share cloudinit image provision push; do
  # shellcheck source=/dev/null
  . "$LIB_DIR/$f.sh"
done

VM=agentcage
RAM_MB=2048
VCPUS=2
DISK_GB=10
POOL_DIR=""
GUEST_USER=""
GUEST_DOAS=1
GUEST_PW_HASH=""
ASK_PW=0
HARNESS=claude-code
AUTOSTART=0
SHARE_DIR=""
SHARE_CREATED=0
ALLOW_LAN=0
WHO=""
AGENT_MD=""
NO_PACKAGES=0
SKIP_PACKAGES=""
SSH_PUBKEY=""
DRY_RUN=${DRY_RUN:-0}
VERBOSE=${VERBOSE:-0}
ASSUME_YES=0
NO_WAIT=0
GOLDEN=0
BACKEND=${AGENTCAGE_BACKEND:-libvirt}; BACKEND_SET=0
NAME_SET=0; USER_SET=0; RAM_SET=0; VCPUS_SET=0; DISK_SET=0; KEY_SET=0; DOAS_SET=0; POOL_SET=0
HARNESS_SET=0; SHARE_SET=0; LAN_SET=0; AUTOSTART_SET=0
SSH_ARGS=()
PUSH_PATHS=()
PUSH_TO=.

usage() {
  cat <<EOF
Usage: acage <command> [name] [options]

Commands:
  image            Download and verify the latest Alpine cloud image only
  create           Download and verify the image, then create and boot a VM
  quick [NAME]     One command, no questions: create a VM with the defaults
                   (claude-code, autostart) and log straight into the agent.
                   Reuses a cached golden image; re-attaches if NAME exists.
  bake             Pre-build a reusable image with the packages and harness
                   baked in, so later creates skip the apk/npm install
  attach NAME      Log in to a VM (starting it first if stopped), asking
                   whether as the agent or as you
  tmux NAME        Open two side-by-side shells in tmux: the agent (left) and
                   you (right). Starts the VM first if stopped. Needs tmux.
  push NAME PATH...  Copy files or folders from here into the agent's home
  ssh NAME [-- CMD]  Run CMD in a VM (as the agent unless --user)
  start NAME       Start a stopped VM
  stop NAME        Shut a VM down
  console NAME     Show the VM's serial console / boot output
  list             List VMs
  delete NAME      Delete a VM and its disk
  uninstall        Remove every VM and all acage data, and print how to
                   remove the host packages nothing else needs

Every VM has two accounts: 'agent', which runs the AI and has no root, and
yours, which can use doas.

Options for create:
  --name NAME       VM name, also its hostname and SSH alias (default: $VM)
  --user NAME       Your account in the VM (default: your username)
  --harness LIST    Agent harness(es) to install, comma-separated:
                    claude-code, pi, codex, or none (default: $HARNESS)
  --no-packages     Install no apk packages in the VM (no dev tools, no
                    harness). Disables the in-VM firewall unless --allow-lan,
                    since that needs nftables. For a bare cage you set up
                    yourself; ignored when a prebuilt golden image is used.
  --skip-packages LIST
                    Don't install these packages (comma/space-separated;
                    repeatable). Excluding nftables drops the firewall;
                    excluding npm drops the harness.
  --agent-md FILE   Install FILE in the agent's home as both CLAUDE.md and
                    AGENTS.md, so its harness picks up your instructions
  --share DIR       Share host folder DIR with the VM at ~/shared (created if
                    missing; asked interactively with the default
                    /mnt/acage-shared/NAME).
                    Read the warning it prints: this weakens the isolation.
  --no-share        Don't share a folder (the default; pins it so nothing is
                    asked interactively)
  --password        Set a password for your account (asked, hidden). doas
                    then asks for it; without one doas needs no password.
  --no-doas         Don't give your account root either
  --autostart       Log in as the agent straight into its harness; quit it for
                    a shell. Asked interactively (default yes); --no-autostart
                    turns it off.
  --allow-lan       Let the VM reach your local network and this host
                    (default: internet only)
  --no-lan          Keep the VM off your LAN and this host (the default; pins
                    it so nothing is asked interactively)
  --ram MB          RAM in MB (default: $RAM_MB)
  --vcpus N         vCPUs (default: $VCPUS)
  --disk GB         Disk size in GB (default: $DISK_GB)
  --ssh-pubkey FILE Public key to authorize (default: ~/.ssh/id_agentcage.pub,
                    created if missing)
  --no-wait         Start the VM and return, without waiting for first boot

Options for attach/ssh/push:
  --agent, --user   Log in as the agent (ssh's default) or as you, without
                    being asked; push copies into that account's home
  --to DIR          push: copy into DIR (inside the home) instead of the home

General options:
  --backend NAME    libvirt (default), or qemu to run QEMU directly
                    without libvirt
  --pool-dir DIR    Where images and disks are kept. Remembered for later
                    commands. Default: libvirt /var/lib/libvirt/images/agentcage
                    (/home/agentcage if / is a smaller, separate partition),
                    qemu ~/.local/share/agentcage
  -y, --yes         Don't ask for confirmations (image key fingerprint,
                    shared-folder warning, delete)
  -n, --dry-run     Print what would change instead of changing it
  -v, --verbose     Print each command acage runs as it installs or boots
  -h, --help        Show this help
  --version         Show the version

Settings for create that aren't given as options are asked for when
running in a terminal; otherwise the defaults above are used.
EOF
}

cmd=""
need_value() { [ $# -ge 2 ] || die "$1 needs a value"; }
while [ $# -gt 0 ]; do
  case "$1" in
    --name) need_value "$@"; VM=$2; NAME_SET=1; shift 2 ;;
    --user)
      # A flag for attach/ssh, a name for create.
      case "$cmd" in
        attach|ssh|push) WHO=user; shift ;;
        *) need_value "$@"; GUEST_USER=$2; USER_SET=1; shift 2 ;;
      esac ;;
    --agent) WHO=agent; shift ;;
    --to) need_value "$@"; PUSH_TO=$2; shift 2 ;;
    --allow-lan) ALLOW_LAN=1; LAN_SET=1; shift ;;
    --no-lan) ALLOW_LAN=0; LAN_SET=1; shift ;;
    --harness) need_value "$@"; HARNESS=$2; HARNESS_SET=1; shift 2 ;;
    --no-packages) NO_PACKAGES=1; shift ;;
    --skip-packages) need_value "$@"; SKIP_PACKAGES="$SKIP_PACKAGES $2"; shift 2 ;;
    --agent-md) need_value "$@"; AGENT_MD=$2; shift 2 ;;
    --share) need_value "$@"; SHARE_DIR=$2; SHARE_SET=1; shift 2 ;;
    --no-share) SHARE_DIR=""; SHARE_SET=1; shift ;;
    --ram) need_value "$@"; RAM_MB=$2; RAM_SET=1; shift 2 ;;
    --vcpus) need_value "$@"; VCPUS=$2; VCPUS_SET=1; shift 2 ;;
    --disk) need_value "$@"; DISK_GB=$2; DISK_SET=1; shift 2 ;;
    --pool-dir) need_value "$@"; POOL_DIR=$2; POOL_SET=1; shift 2 ;;
    --ssh-pubkey) need_value "$@"; SSH_PUBKEY=$2; KEY_SET=1; shift 2 ;;
    --backend) need_value "$@"; BACKEND=$2; BACKEND_SET=1; shift 2 ;;
    --password) ASK_PW=1; shift ;;
    --doas) GUEST_DOAS=1; DOAS_SET=1; shift ;;
    --no-doas) GUEST_DOAS=0; DOAS_SET=1; shift ;;
    --autostart) AUTOSTART=1; AUTOSTART_SET=1; shift ;;
    --no-autostart) AUTOSTART=0; AUTOSTART_SET=1; shift ;;
    --no-wait) NO_WAIT=1; shift ;;
    -n|--dry-run) DRY_RUN=1; shift ;;
    -v|--verbose) VERBOSE=1; shift ;;
    -y|--yes) ASSUME_YES=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --version) echo "acage $VERSION"; exit 0 ;;
    --) shift; SSH_ARGS=("$@"); break ;;
    -*) die "Unknown option: $1 (see acage --help)" ;;
    *)
      if [ -z "$cmd" ]; then cmd=$1
      elif [ "$NAME_SET" = 0 ]; then VM=$1; NAME_SET=1
      elif [ "$cmd" = push ]; then PUSH_PATHS+=("$1")
      else die "Unexpected argument: $1"
      fi
      shift ;;
  esac
done
[ -n "$cmd" ] || { usage; exit 1; }
[ "$(uname -s)" = Linux ] || die "acage needs a Linux host with KVM"
# Running as root would put your SSH key, settings and the VM login in root's
# home and undo the isolation acage is for. The libvirt backend elevates with
# sudo only for the few commands that need it. (--help/--version exit above.)
[ "$(id -u)" != 0 ] || die "Don't run acage as root; run it as your normal user"

# Backends (lib/backend-NAME.sh) all define the same functions:
#   backend_init          set POOL_DEFAULT, POOL_ROOT, IMAGE_ARCH, SHARE_FSTYPE
#   backend_check_deps    record missing tools with want(), then report_missing
#   pool_ensure, pool_exists FILE
#   backend_exists VM, backend_running VM
#   backend_create VM     disk + seed + define + start
#   backend_wait VM       set SSH_HOST/SSH_PORT once the VM is reachable
#   backend_locate VM     set SSH_HOST/SSH_PORT for a running VM
#   backend_start VM, backend_stop VM, backend_delete VM
#   backend_list, backend_console VM
# Baking always uses the qemu backend: it needs no sudo and produces a plain
# qcow2 that either backend can then base cages on.
[ "$cmd" != bake ] || BACKEND=qemu
# 'quick' is a zero-prompt one-liner, so it defaults to the qemu backend (no
# sudo); pass --backend to override.
[ "$cmd" != quick ] || [ "$BACKEND_SET" = 1 ] || BACKEND=qemu
case "$BACKEND" in
  libvirt|qemu) ;;
  *) die "Unknown backend '$BACKEND' (libvirt or qemu)" ;;
esac
# shellcheck source=/dev/null
. "$LIB_DIR/backend-$BACKEND.sh"
backend_init
[ "$POOL_SET" = 1 ] || pool_pick_default
pool_validate

# A valid hostname label that YAML won't read as a number or boolean.
valid_vm_name() { [[ "$1" =~ ^[a-z][a-z0-9-]{0,62}$ ]] && [[ "$1" != *- ]]; }
check_name() {
  valid_vm_name "$VM" \
    || die "Invalid VM name '$VM' (lowercase letters, digits and -, starting with a letter)"
}

# Ask about anything create needs that wasn't given on the command line.
# Skipped when not running in a terminal (piped input, scripts, CI).
prompt_settings() {
  interactive || return 0
  # Your account defaults to your host username without asking, to keep install
  # quick; --user overrides it. Set it here too so the doas/password prompts
  # below can name it.
  [ "$USER_SET" = 1 ] || GUEST_USER=$(id -un | tr 'A-Z' 'a-z')
  echo "Settings (press Enter to keep each default):" >&2
  echo "  your account in the VM is '$GUEST_USER' (override with --user NAME)" >&2
  [ "$NAME_SET" = 1 ]    || ask VM "VM name" "$VM"
  [ "$HARNESS_SET" = 1 ] || ask HARNESS "Agent harness(es): claude-code, pi, codex (comma-separated) or none" "$HARNESS"
  [ "$RAM_SET" = 1 ]     || ask RAM_MB "RAM in MB" "$RAM_MB"
  [ "$VCPUS_SET" = 1 ]   || ask VCPUS "vCPUs" "$VCPUS"
  [ "$DISK_SET" = 1 ]    || ask DISK_GB "Disk size in GB" "$DISK_GB"
  [ "$POOL_SET" = 1 ]    || ask POOL_DIR "Folder for images and VM disks ($(set -- $(fs_info "$POOL_DIR"); echo "$1 GB free on $2"))" "$POOL_DIR"
  [ "$KEY_SET" = 1 ]     || ask SSH_PUBKEY "SSH public key to authorize (Enter: ~/.ssh/id_agentcage.pub, created if missing)" "$SSH_PUBKEY"
  [ "$DOAS_SET" = 1 ]    || { if yesno "Give your account '$GUEST_USER' root in the VM (doas)? The agent never gets it" y; then GUEST_DOAS=1; else GUEST_DOAS=0; fi; }
  [ "$LAN_SET" = 1 ]     || { yesno "Let the VM reach your local network and this host? (default: internet only)" n && ALLOW_LAN=1 || true; }
  [ "$AUTOSTART_SET" = 1 ] || [ "$HARNESS" = none ] || { yesno "Log straight into the agent's AI when you attach as the agent? (quit it for a shell)" y && AUTOSTART=1 || true; }
  if [ "$SHARE_SET" != 1 ] && yesno "Share a host folder with the VM? (weakens isolation; you'll see a warning)" n; then
    ask SHARE_DIR "Folder to share" "$(share_default_dir "$VM")"
  fi
  echo >&2
}

validate_settings() {
  check_name
  is_uint "$RAM_MB" && [ "$RAM_MB" -ge 512 ] || die "--ram must be a whole number of MB, at least 512 (got '$RAM_MB')"
  is_uint "$VCPUS" && [ "$VCPUS" -le 64 ] || die "--vcpus must be a whole number from 1 to 64 (got '$VCPUS')"
  is_uint "$DISK_GB" && [ "$DISK_GB" -le 4096 ] || die "--disk must be a whole number of GB (got '$DISK_GB')"
  SSH_PUBKEY=${SSH_PUBKEY/#\~/$HOME}
  GUEST_USER=${GUEST_USER:-$(id -un | tr 'A-Z' 'a-z')}
  harness_validate
  cloudinit_validate
  [ -z "$SHARE_DIR" ] || share_resolve
  pool_validate
}

cmd_image() {
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}"
  mkdir -p "$cache"
  IMG_TMP=$(mktemp -d "$cache/agentcage-image.XXXXXX")
  trap 'rm -rf "${IMG_TMP:-}"' EXIT
  alpine_image_ensure "$IMAGE_ARCH" >/dev/null
  # Clean up now rather than only on exit: create may end in 'exec ssh',
  # which would skip the EXIT trap.
  rm -rf "$IMG_TMP"; IMG_TMP=""
  trap - EXIT
}

# Builds a golden image: a flattened base with the packages and harness set
# pre-installed, so later creates for the same set skip the apk + npm work.
# Provisions once in a throwaway qemu VM that installs, strips its own identity
# (host keys, machine-id) and powers off; its disk is then flattened and cached.
cmd_bake() {
  local golden tmpvm="acage-bake-$$" n
  # A golden image exists to carry the full package set; filtering it would
  # defeat the purpose, so the package flags aren't honored here.
  [ "$NO_PACKAGES" = 0 ] && [ -z "${SKIP_PACKAGES// }" ] \
    || die "--no-packages/--skip-packages aren't supported for 'bake': a golden image installs the full package set. Use them on 'create' instead."
  cmd_image                                  # make sure the verified base is cached
  golden=$(alpine_golden_name "$IMAGE_ARCH" "$HARNESS")
  [ -n "$golden" ] || die "No base image is cached"
  if [ -e "$golden" ]; then
    log "Golden image already exists: $(basename "$golden") (delete it to rebuild)"
    return 0
  fi
  BAKE=1
  if dry; then
    backend_create "$tmpvm"
    echo "(dry-run) would wait for the bake VM to power off, then flatten its disk to $golden" >&2
    return 0
  fi
  log "Baking a golden image for harness '$HARNESS' (provisions once; a few minutes)"
  backend_create "$tmpvm"
  echo -n "Installing packages, then powering off" >&2
  # A successful bake powers off in about a minute; cap the wait at five so a
  # stuck or failed install fails fast. The VM is left in place on timeout so
  # 'acage console' can show why (the harness install logs to its console).
  for n in $(seq 1 150); do backend_running "$tmpvm" || break; echo -n "." >&2; sleep 2; done
  echo >&2
  if backend_running "$tmpvm"; then
    die "Bake VM did not power off in time; see 'acage console $tmpvm', then 'acage delete $tmpvm --backend qemu'"
  fi
  log "Flattening to $(basename "$golden")"
  if ! qemu-img convert -O qcow2 "$(vm_dir "$tmpvm")/disk.qcow2" "$golden"; then
    rm -f "$golden"; backend_delete "$tmpvm"; die "Could not flatten the bake disk"
  fi
  backend_delete "$tmpvm"
  log "Golden image ready: $(basename "$golden") ($(du -h "$golden" 2>/dev/null | cut -f1)); 'acage create --harness $HARNESS' will now use it."
}

# One command, no questions: create a VM with the defaults (the claude-code
# harness, autostart on, image fingerprint accepted), then log straight into
# the agent with its harness running. Reuses a cached golden image, so a repeat
# launch is quick, and re-attaches if the VM already exists. Uses the qemu
# backend unless --backend says otherwise.
cmd_quick() {
  ASSUME_YES=1; QUICK=1
  [ "$HARNESS_SET" = 1 ]   || HARNESS=claude-code
  [ "$AUTOSTART_SET" = 1 ] || AUTOSTART=1
  [ "$USER_SET" = 1 ]      || GUEST_USER=$(id -un | tr 'A-Z' 'a-z')
  [ "$NAME_SET" = 1 ]      || VM=quick
  check_name
  if backend_exists "$VM"; then
    log "'$VM' already exists; attaching to the '$AGENT_USER' account"
  else
    harness_validate
    if ! dry; then
      want xorriso; want ssh-keygen; want curl; want gpg; backend_check_deps
    fi
    check_space "$DISK_GB" "a ${DISK_GB} GB VM disk"
    check_space 1 "the Alpine image" "$IMAGE_CACHE"
    pool_remember
    cmd_image
    cmd_create || return 1
  fi
  dry && return 0
  WHO=agent
  cmd_attach
}

cmd_create() {
  if backend_exists "$VM"; then die "VM '$VM' already exists (acage delete $VM)"; fi
  [ -z "$AGENT_MD" ] || [ -f "$AGENT_MD" ] || die "--agent-md: file not found: $AGENT_MD"
  [ -z "$SHARE_DIR" ] || { share_confirm; share_create; }
  if [ "$ASK_PW" = 1 ]; then
    interactive || die "--password needs a terminal to type the password in"
    ask_password GUEST_PW_HASH "Password for '$GUEST_USER' in the VM"
  fi
  # -f: ssh-keygen otherwise edits the login user's file, whatever HOME says.
  [ -f "$HOME/.ssh/known_hosts" ] && run ssh-keygen -R "$VM" -f "$HOME/.ssh/known_hosts" >/dev/null 2>&1 || true

  # Use a golden image if one is baked for this harness set: cages built from it
  # skip the apk + npm work (see 'acage bake').
  local golden
  if golden=$(alpine_cached_golden "$IMAGE_ARCH" "$HARNESS") && [ -n "$golden" ]; then
    GOLDEN=1
    log "Using golden image $(basename "$golden") (packages and harness already installed)"
  fi

  backend_create "$VM"
  # Remembered so 'acage attach' knows your account and 'acage delete' the share.
  if ! dry; then
    config_set "user_$VM" "$GUEST_USER"
    [ -z "$SHARE_DIR" ] || config_set "share_$VM" "$SHARE_DIR"
    [ "$SHARE_CREATED" != 1 ] || config_set "share_created_$VM" 1
  fi

  if dry; then
    echo "(dry-run) would then wait for first boot, add an SSH config entry, and offer" >&2
    echo "(dry-run) to store API keys, make a deploy key and connect." >&2
    return 0
  fi
  if [ "$NO_WAIT" = 1 ]; then
    image_next_steps
    return 0
  fi
  echo >&2
  if ! backend_wait "$VM"; then
    image_next_steps
    return 1
  fi
  if ! provision_vm "$VM" "$GUEST_USER"; then
    image_next_steps
    return 1
  fi
}

cmd_ssh() {
  local user=$AGENT_USER
  backend_locate "$VM"
  sync_ssh_config_host "$VM"
  [ "$WHO" != user ] || user=$(vm_user "$VM")
  exec ssh -o "HostName=$SSH_HOST" -o "Port=$SSH_PORT" -o "User=$user" \
    -o "HostKeyAlias=$VM" -o StrictHostKeyChecking=accept-new "$VM" ${SSH_ARGS[@]+"${SSH_ARGS[@]}"}
}

cmd_push() {
  local user=$AGENT_USER
  [ ${#PUSH_PATHS[@]} -gt 0 ] || die "What should be copied? acage push $VM PATH..."
  backend_locate "$VM"
  sync_ssh_config_host "$VM"
  [ "$WHO" != user ] || user=$(vm_user "$VM")
  push_paths "$VM" "$user" "$PUSH_TO" "${PUSH_PATHS[@]}"
}

# ensure_up VM -> start the VM if it's stopped and wait until sshd accepts the key.
ensure_up() {
  local vm=$1
  backend_running "$vm" && return 0
  log "$vm is stopped; starting it"
  backend_start "$vm"
  backend_wait "$vm" || die "$vm started but did not come up (acage console $vm)"
  wait_for_key_login "$vm" "$AGENT_USER" || die "$vm booted but SSH is not ready yet"
}

cmd_attach() {
  backend_exists "$VM" || die "No VM named '$VM' (acage list)"
  ensure_up "$VM"
  backend_locate "$VM"
  sync_ssh_config_host "$VM"
  attach "$VM" "$WHO"
}

# cmd_tmux -> one command, two shells: a host-side tmux with the agent account on
# the left (run the AI) and your account on the right (doas), each its own SSH
# into the cage. Splitting on the host (not inside the VM) is what lets the two
# panes be different accounts.
cmd_tmux() {
  backend_exists "$VM" || die "No VM named '$VM' (acage list)"
  need tmux "the two-pane 'acage tmux' session; or use 'acage attach'"
  ensure_up "$VM"
  backend_locate "$VM"
  sync_ssh_config_host "$VM"
  local user a_ssh y_ssh sess
  user=$(vm_user "$VM")
  local hk="-o HostKeyAlias=$VM -o StrictHostKeyChecking=accept-new"
  a_ssh="ssh -o HostName=$SSH_HOST -o Port=$SSH_PORT -o User=$AGENT_USER $hk $VM"
  y_ssh="ssh -o HostName=$SSH_HOST -o Port=$SSH_PORT -o User=$user $hk $VM"
  sess="acage-$VM"
  if [ -n "${TMUX:-}" ]; then
    # Already inside tmux: open the pair as a new window in the current session.
    tmux new-window -n "$VM" "$a_ssh"
    tmux split-window -h "$y_ssh"
    tmux select-pane -L
  else
    tmux kill-session -t "$sess" 2>/dev/null || true
    tmux new-session -d -s "$sess" -n "$VM" "$a_ssh"
    tmux split-window -h -t "$sess" "$y_ssh"
    tmux set-option -t "$sess" pane-border-status top 2>/dev/null || true
    tmux select-pane -t "$sess:0.0" -T "$AGENT_USER — runs the AI" 2>/dev/null || true
    tmux select-pane -t "$sess:0.1" -T "$user — you (doas)" 2>/dev/null || true
    tmux select-pane -t "$sess:0.0" 2>/dev/null || true
    exec tmux attach -t "$sess"
  fi
}

# confirm_destroy GERUND DECLINE_MSG -> make the user confirm an irreversible
# removal, unless --yes; without a terminal, --yes is required.
confirm_destroy() {
  [ "$ASSUME_YES" = 1 ] && return 0
  interactive || die "$1 needs confirmation: run interactively or add --yes"
  yesno "Are you sure? This can't be undone." n || die "$2"
}

# purge_vm VM -> removes a VM (if it still exists) and everything acage saved
# for it: its SSH config block, its known_hosts key and its settings. A shared
# folder acage created is offered for deletion separately. No confirmation of
# its own; the caller asks first.
purge_vm() {
  local vm=$1 share created
  share=$(config_get "share_$vm")
  created=$(config_get "share_created_$vm")
  # Always call backend_delete: it removes the VM when it exists, and otherwise
  # sweeps any orphaned disk/seed files a half-finished delete left behind.
  backend_delete "$vm"
  if ! dry; then
    remove_ssh_config_entry "$vm"
    [ -f "$HOME/.ssh/known_hosts" ] && ssh-keygen -R "$vm" -f "$HOME/.ssh/known_hosts" >/dev/null 2>&1 || true
    config_unset "user_$vm"
    config_unset "share_$vm"
    config_unset "share_created_$vm"
  fi
  log "Deleted $vm"
  [ -z "$share" ] || share_offer_delete "$share" "$created"
}

# Deletes a VM and everything acage set up for it on this computer. Also
# cleans up after a create that failed half-way, when only settings are left.
cmd_delete() {
  local exists=1 share
  backend_exists "$VM" || exists=0
  share=$(config_get "share_$VM")
  if [ "$exists" = 0 ] && ! grep -qxF "$(ssh_marker_begin "$VM")" "$HOME/.ssh/config" 2>/dev/null \
       && [ -z "$(config_get "user_$VM")$share" ]; then
    die "No VM named '$VM'"
  fi
  {
    if [ "$exists" = 1 ]; then
      echo "This deletes '$VM':"
      echo "  - the VM, its disk and its first-boot config"
    else
      echo "There's no VM named '$VM' any more, but these are left over and will be removed:"
    fi
    echo "  - its 'Host $VM' entry in ~/.ssh/config and its host key in ~/.ssh/known_hosts"
    echo "  - acage's saved settings for it"
    [ -z "$share" ] || echo "Its shared folder $share is not part of this; you'll be asked about it separately."
    echo "Your SSH key, the downloaded Alpine image and other VMs are kept."
  } >&2
  confirm_destroy "Deleting" "Nothing was deleted"
  purge_vm "$VM"
}

# Every VM name acage knows about, from its saved settings and its SSH config.
acage_vm_names() {
  { [ -f "$CONFIG_FILE" ] && sed -n 's/^user_\([^=]*\)=.*/\1/p' "$CONFIG_FILE"
    [ -f "$HOME/.ssh/config" ] && sed -n 's/^# agentcage:begin //p' "$HOME/.ssh/config"
    true   # keep the group's status zero for the pipe under set -e
  } 2>/dev/null | sort -u
}

# Removes everything acage put on this computer: every VM on this backend, the
# generated SSH key, all its SSH config entries and host keys, the image cache,
# the settings and the pool directory. It never removes host packages; it
# prints a command to remove the ones nothing else needs at the end.
# Lists VM names on the qemu backend (file-based, so no root and no prompt),
# in a subshell so the current backend's functions and variables are untouched.
# Used only to show them before an uninstall confirms.
uninstall_qemu_vm_names() {
  ( . "$LIB_DIR/backend-qemu.sh"; backend_init; pool_pick_default
    backend_list 2>/dev/null | awk 'NR>1 && $1 ~ /^[a-z]/ {print $1}' )
}

# Destroys every VM on BACKEND (the argument) and removes its pool, in a
# subshell that sources that backend. Run for the backend the user did NOT
# select, so 'acage uninstall' clears what the other backend made -- notably
# 'acage quick', which always uses qemu. VM teardown comes from the backend's
# own list, so it works even when the acage config is already gone.
uninstall_sweep_backend() {
  local be=$1 vm
  ( . "$LIB_DIR/backend-$be.sh"; backend_init; pool_pick_default
    for vm in $(backend_list 2>/dev/null | awk 'NR>1 && $1 ~ /^[a-z]/ {print $1}'); do
      valid_vm_name "$vm" && backend_delete "$vm" || true
    done
    [ ! -e "$POOL_DIR" ] || prun rm -rf "$POOL_DIR"
    [ "$be" != qemu ] || run rm -rf "/tmp/agentcage-$(id -u)" )
}

cmd_uninstall() {
  local vms vm key=$HOME/.ssh/id_agentcage other=qemu qvms=""
  [ "$BACKEND" = qemu ] && other=libvirt
  vms=$(acage_vm_names)
  # The other backend is swept too; for qemu we can list its VMs cheaply.
  [ "$other" = qemu ] && qvms=$(uninstall_qemu_vm_names)
  {
    echo "This removes everything acage set up on this computer:"
    [ -z "$vms" ]  || { echo "  - these VMs on the $BACKEND backend, and their disks:"; echo "$vms" | sed 's/^/        /'; }
    [ -z "$qvms" ] || { echo "  - these VMs on the qemu backend, and their disks:"; echo "$qvms" | sed 's/^/        /'; }
    [ "$other" = qemu ] || echo "  - any VMs acage made on the $other backend, and their disks"
    echo "  - every 'Host' entry acage added to ~/.ssh/config, and their host keys"
    echo "  - the generated SSH key $key(.pub)"
    echo "  - the image cache $(dirname "$IMAGE_CACHE")"
    echo "  - the settings $(dirname "$CONFIG_FILE")"
    echo "  - the pool directory $POOL_DIR (and the $other backend's)"
    echo "The acage program and your host packages (QEMU, libvirt, ...) are NOT removed"
    echo "here; a command to remove the unneeded packages is printed at the end."
  } >&2
  confirm_destroy "Uninstalling" "Nothing was removed"
  for vm in $vms; do
    valid_vm_name "$vm" || { warn "skipping unexpected VM name '$vm'"; continue; }
    purge_vm "$vm"
  done
  prun rm -rf "$POOL_DIR"
  [ "$BACKEND" != qemu ] || run rm -rf "/tmp/agentcage-$(id -u)"
  # Sweep the other backend's VMs and pool (after the confirmation, so any sudo
  # it needs comes only once the user has agreed).
  uninstall_sweep_backend "$other"
  run rm -f "$key" "$key.pub"
  run rm -rf "$(dirname "$IMAGE_CACHE")"
  run rm -rf "$(dirname "$CONFIG_FILE")"   # last: purge_vm above reads/writes it
  log "Removed acage's data"
  uninstall_pkg_hint
}

# Prints a reviewed command to remove the host packages acage needed, listing
# only those nothing else installed still requires. The package manager works
# out which that is (including packages that depend on each other); acage only
# prints the command and never runs it.
uninstall_pkg_hint() {
  local mgr="" pkg req removable="" kept=""
  if command -v pacman >/dev/null 2>&1; then mgr=pacman
  elif command -v apt-get >/dev/null 2>&1; then mgr=apt; fi
  echo >&2
  if [ "$mgr" = pacman ]; then
    for pkg in qemu-base edk2-ovmf libvirt libisoburn virtiofsd; do
      pacman -Qq "$pkg" >/dev/null 2>&1 || continue
      req=$(pacman -Qi "$pkg" 2>/dev/null | sed -n 's/^Required By *: *//p' | tr -s ' ')
      case "$req" in ""|None|acage) removable="$removable $pkg" ;; *) kept="$kept $pkg (needed by $req);" ;; esac
    done
    log "To remove the acage program and the host packages nothing else needs:"
    if pacman -Qq acage >/dev/null 2>&1; then
      echo "    sudo pacman -Rns acage$removable" >&2
    elif [ -n "$removable" ]; then
      echo "    sudo pacman -Rns$removable   # plus the acage program, however you installed it" >&2
    else
      echo "    (every package acage used is still needed by something else)" >&2
    fi
  elif [ "$mgr" = apt ]; then
    for pkg in qemu-system-x86 qemu-utils ovmf libvirt-daemon-system xorriso virtiofsd; do
      dpkg -s "$pkg" >/dev/null 2>&1 || continue
      if apt-cache rdepends --installed "$pkg" 2>/dev/null | sed '1,2d' | grep -q '[^[:space:]]'; then
        kept="$kept $pkg"
      else
        removable="$removable $pkg"
      fi
    done
    log "To remove the acage program and the host packages nothing else needs:"
    echo "    sudo make uninstall        # the acage program, from the source checkout" >&2
    [ -n "$removable" ] && echo "    sudo apt-get purge$removable && sudo apt-get autoremove --purge" >&2
    [ -n "$removable" ] || echo "    (every package acage used is still needed by something else)" >&2
  else
    log "Remove the acage program and the host packages (QEMU, libvirt, UEFI firmware, xorriso, virtiofsd) with your package manager, if nothing else needs them."
    return 0
  fi
  [ -z "$kept" ] || echo "  Kept, still needed by other software:$kept" >&2
  echo "  Review the command before running it." >&2
}

need_name() { [ "$NAME_SET" = 1 ] || die "Which VM? acage $cmd NAME"; check_name; }

case "$cmd" in
  image)
    dry || { want curl; want gpg; report_missing; }
    check_space 1 "the Alpine image" "$IMAGE_CACHE"
    cmd_image ;;
  create)
    prompt_settings
    validate_settings
    # Check every host tool up front and report all that are missing at once,
    # with an install hint. A dry run skips this (it changes nothing anyway).
    if ! dry; then
      want xorriso; want ssh-keygen; want curl; want gpg
      [ "$ASK_PW" != 1 ] || want openssl
      backend_check_deps
    fi
    # A VM disk starts small but can grow to its full --disk size.
    check_space "$DISK_GB" "a ${DISK_GB} GB VM disk"
    check_space 1 "the Alpine image" "$IMAGE_CACHE"
    pool_remember
    cmd_image     # ensure the verified image is cached (reuses it if present)
    cmd_create ;;
  bake)
    harness_validate
    if ! dry; then want xorriso; want curl; want gpg; backend_check_deps; fi
    check_space 1 "the Alpine image" "$IMAGE_CACHE"
    cmd_bake ;;
  quick) cmd_quick ;;
  attach) need_name; cmd_attach ;;
  tmux) need_name; cmd_tmux ;;
  push) need_name; cmd_push ;;
  ssh) need_name; cmd_ssh ;;
  start) need_name; backend_start "$VM" ;;
  stop) need_name; backend_stop "$VM" ;;
  console) need_name; backend_console "$VM" ;;
  delete) need_name; cmd_delete ;;
  list) backend_list ;;
  uninstall) cmd_uninstall ;;
  # Hidden: machine-readable VM names for shell completion. Reads only the
  # config and ~/.ssh/config (no sudo, no libvirt query), so it stays instant.
  _complete) acage_vm_names ;;
  help) usage ;;
  *) die "Unknown command: $cmd (see acage --help)" ;;
esac
